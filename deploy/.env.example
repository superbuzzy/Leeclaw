# Never commit deploy/.env.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
SILICONFLOW_API_KEY=replace-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=WeKnora
REDIS_PASSWORD=replace-me
JWT_SECRET=replace-me
SYSTEM_AES_KEY=replace-with-exactly-32-bytes
NEO4J_ENABLE=true
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
FRONTEND_PORT=8081
APP_PORT=8080

LEECLAW_RUNTIME_TOKEN=replace-me
LEECLAW_PROMOTION_TOKEN=replace-me
COBRA_REGISTRY_ADMIN_TOKEN=replace-me
OPENVIKING_ROOT_API_KEY=replace-me
OPENVIKING_API_KEY=replace-me
OPENVIKING_IMAGE=ghcr.io/volcengine/openviking:v0.4.19
OPENCLAW_GATEWAY_TOKEN=replace-me
OPENCLAW_CONFIG_DIR=/absolute/path/to/Leeclaw/deploy/openclaw/state
OPENCLAW_WORKSPACE_DIR=/absolute/path/to/Leeclaw/deploy/openclaw/state/workspace
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_SANDBOX_PORT=18790
# Authenticated identity presented to OpenClaw trusted-proxy auth. OpenClaw
# derives the durable Profile from this value; browsers cannot override it.
LEECLAW_OPENCLAW_IDENTITY=leeclaw@local.invalid
LEECLAW_OPENCLAW_ROLE=owner
WEKNORA_API_KEY_LEECLAW=
WEKNORA_TENANT_ID=10000
WEKNORA_BOOTSTRAP_EMAIL=leeclaw@local.invalid
WEKNORA_BOOTSTRAP_PASSWORD=
